#!/usr/bin/env bash
# Dispatcher: common checks for every repo, then repo-specific logic.
# Sourced scripts get $ROOT (repo root) and $HOOKS_DIR.
set -euo pipefail

HOOKS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(git rev-parse --show-toplevel)"

source "$HOOKS_DIR/common.sh"

case "$(basename "$ROOT")" in
    anki-card-creator)      source "$HOOKS_DIR/projects/anki-card-creator.sh" ;;
    anki-chrome-extension)  source "$HOOKS_DIR/projects/anki-chrome-extension.sh" ;;
    finances)               source "$HOOKS_DIR/projects/hledger.sh" ;;
    hledger-graphs)         source "$HOOKS_DIR/projects/hledger-graphs.sh" ;;
    pth)                    source "$HOOKS_DIR/projects/pth.sh" ;;
    routines)               source "$HOOKS_DIR/projects/routines.sh" ;;
esac

exit 0
